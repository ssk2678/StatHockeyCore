<!DOCTYPE html>
<html>
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <title>StatHockey</title>
    <meta name="keywords" content="" />
    <meta name="description" content="" />
    <environment include="Development">
        <link rel="stylesheet" href="~/css/datepicker.min.css">
        <link href="~/css/statHockey.css" rel="stylesheet" type="text/css" media="all" />
        <link href="~/lib/bootstrap/dist/css/bootstrap.css" />
        <link href="~/lib/bootstrap/dist/css/bootstrap-grid.css" />
        <link href="~/lib/bootstrap/dist/css/bootstrap-reboot.css" />
        <script src="~/js/Common.js"></script>
        <script src="~/js/StatHockey.js"></script>
        <script src="~/js/datepicker.js"></script>
        <script src="~/js/moment.js"></script>
        <script src="~/js/moment-with-locales.js"></script>
        <script src="~/js/respond.js"></script>
        <script src="~/lib/jquery/dist/jquery.js"></script>
        <script src="~/lib/bootstrap/dist/js/bootstrap.js"></script>
        


    </environment>
    <!--<link href="http://fonts.googleapis.com/css?family=Source+Sans+Pro:200,300,400,600,700,900" rel="stylesheet" />-->
    
    @*<link rel="stylesheet" href="~/Content/datepicker.less">*@
    
    <!-- <link href="fonts.css" rel="stylesheet" type="text/css" media="all" /> -->
    <!-- [if ie 6] -->
    <!-- <link href="default_ie6.css" rel="stylesheet" type="text/css" /> -->
    <!-- [endif] -->
    <script>
        var MyAppUrlSettings = {            
            teamDataAppUrl: '@Url.Action("GetAllCurrentTeams", "Common")',
            gameDataAppUrl: '@Url.Action("GetTeamGames", "Home")',
            seasonDataAppUrl: '@Url.Action("GetAllSeasons", "Home")',
            teamPlayersDataAppUrl: '@Url.Action("GetTeamSeasonRoster", "Home")',
            teamDetailAppUrl: '@Url.Action("GetTeamData", "Team")',
            playerDetailAppUrl: '@Url.Action("GetPlayerData", "Player")'
        };
    </script> 
</head>
<body>
    <div id="header">
        <div id="logo">
            <div id="logoDiv">
                <img src="~/images/StatHockeyLogoMergeSM.png" />
            </div>
        </div>
        <div id="menu">
            <ul>
                <li><a href="#" accesskey="3" title="">About Us</a></li>
                <li><a href="#" accesskey="5" title="">Contact Us</a></li>
            </ul>
        </div>
        <div id="linksDiv">
            <div id="linksHolder">
                <div class="links">
                    <div id="playersLink" class="hockeyMainBlock playersLink"><a href="#playerOption"><img src="~/images/playersRS.png" /></a></div>
                    <div id="gamesLink" class="hockeyMainBlock gamesLink"><a href="#gameOption"><img src="~/images/gamesRS.png" /></a></div>
                    <div id="teamsLink" class="hockeyMainBlock teamsLink"><a href="#teamOption"><img src="~/images/teamsRS.png" /></a></div>
                </div>
            </div>
        </div>
    </div>
    <div class="body-content">
        @RenderBody()
        
        @*<footer>
            <p>&copy; @DateTime.Now.Year - My ASP.NET Application</p>
        </footer>*@
    </div>
    <div id="copyright">
        
        <p>&copy; 2021, 2020, 2019. StatHockey. All rights reserved. | Images & Logos purchased from <a href="https://www.shutterstock.com/">Shutterstock</a>, <a href="https://www.logomaker.com/">LogoMaker</a>, <a href="https://www.123rf.com/">123rf</a> | Design template from <a href="http://templated.co" rel="nofollow">TEMPLATED</a></p>
    </div>

    @*@Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)*@
</body>
</html>


